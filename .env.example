# Web3Forms access key — get yours free at https://web3forms.com
# Enter your email there and they'll send the key to your inbox.
# Without this set, the form runs in demo mode (simulates submission).
VITE_WEB3FORMS_KEY=your_web3forms_access_key_here
VITE_FORM_ENDPOINT=https://formspree.io/f/YOUR_FORM_ID
