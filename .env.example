# Contact form endpoint (Formspree)
# 1. Sign up free at https://formspree.io
# 2. Create a new form and copy your Form ID
# 3. Set this variable to: https://formspree.io/f/YOUR_FORM_ID
# Without this set, the form runs in demo mode (simulates submission).
VITE_FORM_ENDPOINT=https://formspree.io/f/YOUR_FORM_ID
